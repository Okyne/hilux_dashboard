# Interface Material Design (KivyMD 1.1.1).
# Les jauges/inclinomètre/pneus restent des widgets canvas (légers).
# Les couleurs canvas pointent vers app.c_* (dérivées de theme_cls).

# --------------------------------------------------------------------------- #
#  Racine
# --------------------------------------------------------------------------- #
<RootScreen>:
    FloatLayout:
        Image:
            source: app.bg_image
            fit_mode: "cover"

        MDBoxLayout:
            orientation: "vertical"

            MDTopAppBar:
                id: topbar
                title: app.clock_str
                elevation: 0
                right_action_items: [["weather-night" if not app.night_mode else "white-balance-sunny", lambda x: app.toggle_night()], ["cog", lambda x: app.open_settings()], ["power", lambda x: app.ask_shutdown()]]

            MDBottomNavigation:
                id: nav
                #panel_color: app.theme_cls.primary_color

                # ---------------- Écran 1 : moteur ----------------
                MDBottomNavigationItem:
                    name: "engine"
                    text: "Moteur"
                    icon: "engine"
                    FloatLayout:
                        id: engine_root
                        Image:
                            source: app.bg_image
                            fit_mode: "cover"


                        # -------- jauge huile (gauche) --------
                        VBarGauge:
                            id: g_oil_bar
                            vmin: 50
                            vmax: 140
                            warn: 120
                            alarm: 135
                            size_hint: 0.045, 0.62
                            pos_hint: {"x": 0.03, "center_y": 0.44}
                        MDLabel:
                            text: "130"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"x": 0.09, "top": 0.79}
                        MDLabel:
                            text: "90"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"x": 0.09, "center_y": 0.44}
                        MDLabel:
                            text: "50"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"x": 0.09, "y": 0.14}
                        MDIcon:
                            icon: "oil"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(28), dp(28)
                            pos_hint: {"x": 0.03, "y": 0.02}

                        # -------- jauge niveau carburant (droite) --------
                        VBarGauge:
                            id: g_fuel_bar
                            vmin: 0
                            vmax: 1
                            invert: True
                            warn: 0.2
                            alarm: 0.1
                            size_hint: 0.045, 0.62
                            pos_hint: {"right": 0.97, "center_y": 0.44}
                        MDLabel:
                            text: "1"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "right"
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"right": 0.90, "top": 0.79}
                        MDLabel:
                            text: "1/2"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "right"
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"right": 0.90, "center_y": 0.44}
                        MDLabel:
                            text: "0"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "right"
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"right": 0.90, "y": 0.14}
                        MDIcon:
                            icon: "gas-station"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(28), dp(28)
                            pos_hint: {"right": 0.97, "y": 0.02}

                        # -------- centre : vitesse + cap --------
                        MDLabel:
                            id: g_speed
                            text: "0"
                            font_style: "H2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            halign: "center"
                            size_hint: None, None
                            size: dp(200), dp(70)
                            pos_hint: {"center_x": 0.5, "top": 0.90}
                        MDLabel:
                            text: "km/h"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "center"
                            size_hint: None, None
                            size: dp(200), dp(24)
                            pos_hint: {"center_x": 0.5, "top": 0.75}
                        HeadingArrow:
                            size_hint: None, None
                            size: dp(28), dp(28)
                            pos_hint: {"center_x": 0.5, "center_y": 0.60}
                        MDLabel:
                            id: g_heading
                            text: "N"
                            font_style: "H4"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            halign: "center"
                            size_hint: None, None
                            size: dp(120), dp(40)
                            pos_hint: {"center_x": 0.5, "center_y": 0.45}

                        # -------- consommation (droite du centre) --------
                        MDLabel:
                            id: g_fuel_inst
                            markup: True
                            text: "[size=28sp][b]0,0[/b][/size] l/100km"
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            halign: "right"
                            size_hint: None, None
                            size: dp(200), dp(34)
                            pos_hint: {"right": 0.80, "top": 0.62}
                        MDLabel:
                            text: "inst."
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "right"
                            size_hint: None, None
                            size: dp(200), dp(20)
                            pos_hint: {"right": 0.80, "top": 0.55}
                        MDLabel:
                            id: g_fuel_avg
                            markup: True
                            text: "[size=28sp][b]0,0[/b][/size] l/100km"
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            halign: "right"
                            size_hint: None, None
                            size: dp(200), dp(34)
                            pos_hint: {"right": 0.80, "top": 0.47}
                        MDLabel:
                            text: "moy."
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "right"
                            size_hint: None, None
                            size: dp(200), dp(20)
                            pos_hint: {"right": 0.80, "top": 0.40}

                        # -------- ligne du bas : liquide / batterie / autonomie --------
                        MDIcon:
                            icon: "thermometer"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(24), dp(24)
                            pos_hint: {"x": 0.22, "y": 0.045}
                        MDLabel:
                            text: "C"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(20), dp(24)
                            pos_hint: {"x": 0.27, "y": 0.045}
                        HBarGauge:
                            id: g_coolant_bar
                            vmin: 40
                            vmax: 130
                            warn: 105
                            alarm: 115
                            size_hint: 0.20, 0.045
                            pos_hint: {"x": 0.30, "y": 0.05}
                        MDLabel:
                            text: "H"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(20), dp(24)
                            pos_hint: {"x": 0.51, "y": 0.045}

                        MDIcon:
                            icon: "car-battery"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(24), dp(24)
                            pos_hint: {"x": 0.62, "y": 0.045}
                        MDLabel:
                            id: g_battery
                            markup: True
                            text: "12,7 [size=14sp]v[/size]"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            size_hint: None, None
                            size: dp(90), dp(24)
                            pos_hint: {"x": 0.66, "y": 0.045}

                        MDIcon:
                            icon: "gas-station"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(24), dp(24)
                            pos_hint: {"x": 0.80, "y": 0.045}
                        MDLabel:
                            id: g_range
                            markup: True
                            text: "450 [size=14sp]km[/size]"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            size_hint: None, None
                            size: dp(90), dp(24)
                            pos_hint: {"x": 0.84, "y": 0.045}

                # ---------------- Écran 2 : inclinaison ----------------
                MDBottomNavigationItem:
                    name: "tilt"
                    text: "Inclinaison"
                    icon: "angle-acute"
                    MDBoxLayout:
                        padding: dp(12)
                        spacing: dp(12)
                        MDCard:
                            orientation: "vertical"
                            md_bg_color: app.c_surface[0], app.c_surface[1], app.c_surface[2], 0.85
                            radius: [dp(16),]
                            padding: dp(8)
                            MDLabel:
                                text: "Roulis (lateral)"
                                halign: "center"
                                theme_text_color: "Secondary"
                                size_hint_y: 0.15
                            TiltIndicator:
                                id: roll
                                axis: "roll"
                            MDLabel:
                                text: "{:+.0f} deg".format(roll.angle)
                                halign: "center"
                                font_style: "H4"
                                size_hint_y: 0.2
                        MDCard:
                            orientation: "vertical"
                            md_bg_color: app.c_surface[0], app.c_surface[1], app.c_surface[2], 0.85
                            radius: [dp(16),]
                            padding: dp(8)
                            MDLabel:
                                text: "Tangage (avant/arriere)"
                                halign: "center"
                                theme_text_color: "Secondary"
                                size_hint_y: 0.15
                            TiltIndicator:
                                id: pitch
                                axis: "pitch"
                            MDLabel:
                                text: "{:+.0f} deg".format(pitch.angle)
                                halign: "center"
                                font_style: "H4"
                                size_hint_y: 0.2

                # ---------------- Écran 3 : pneus ----------------
                MDBottomNavigationItem:
                    name: "tires"
                    text: "Pneus"
                    icon: "car-tire-alert"
                    MDBoxLayout:
                        orientation: "vertical"
                        padding: dp(12)
                        MDLabel:
                            text: "Pression pneumatiques (bar)"
                            halign: "center"
                            theme_text_color: "Secondary"
                            size_hint_y: 0.1
                        FloatLayout:
                            TireDiagram:
                                id: tires
                                pos_hint: {"center_x": .5, "center_y": .5}
                            MDLabel:
                                text: "{:.2f}".format(tires.fl)
                                halign: "center"
                                font_style: "H5"
                                size_hint: None, None
                                pos_hint: {"center_x": .30, "center_y": .82}
                            MDLabel:
                                text: "{:.2f}".format(tires.fr)
                                halign: "center"
                                font_style: "H5"
                                size_hint: None, None
                                pos_hint: {"center_x": .70, "center_y": .82}
                            MDLabel:
                                text: "{:.2f}".format(tires.rl)
                                halign: "center"
                                font_style: "H5"
                                size_hint: None, None
                                pos_hint: {"center_x": .30, "center_y": .18}
                            MDLabel:
                                text: "{:.2f}".format(tires.rr)
                                halign: "center"
                                font_style: "H5"
                                size_hint: None, None
                                pos_hint: {"center_x": .70, "center_y": .18}

        # Température extérieure : superposée en haut à gauche de la top bar
        # (celle-ci ne peut pas afficher de texte libre dans ses action items,
        # qui n'acceptent que des icônes).
        MDLabel:
            id: g_ext
            text: "--°"
            font_style: "H6"
            bold: True
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            size_hint: None, None
            size: dp(70), dp(30)
            pos_hint: {"x": 0.01, "top": 0.985}
