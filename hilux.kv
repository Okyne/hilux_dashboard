#:import NoTransition kivy.uix.screenmanager.NoTransition

# Interface Material Design (KivyMD 1.1.1).
# Les jauges/inclinomètre/pneus restent des widgets canvas (légers).
# Les couleurs canvas pointent vers app.c_* (dérivées de theme_cls).

# --------------------------------------------------------------------------- #
#  Racine
# --------------------------------------------------------------------------- #
<RootScreen>:
    FloatLayout:
        Image:
            source: app.bg_image
            fit_mode: "cover"

        MDBoxLayout:
            orientation: "vertical"

            MDTopAppBar:
                id: topbar
                title: app.clock_str
                anchor_title: "center"
                elevation: 0
                md_bg_color: 0, 0, 0, 0.01
                specific_text_color: 1, 1, 1, 1
                right_action_items: [["weather-night" if not app.night_mode else "white-balance-sunny", lambda x: app.toggle_night()], ["cog", lambda x: app.open_settings()], ["power", lambda x: app.ask_shutdown()]]

            MDBottomNavigation:
                id: nav
                #panel_color: app.theme_cls.primary_color
                # NoTransition avoids MDBottomNavigation's default FadeTransition
                # (FBO/shader-based screen compositing). That transition leaves stale
                # GPU framebuffer content visible through transparent gaps in sparse
                # tab layouts (e.g. the tilt tab) after switching tabs — confirmed via
                # screenshots at 0.8s/3s/7.5s post-switch and across every tab pairing.
                transition: NoTransition

                # ---------------- Écran 1 : moteur ----------------
                MDBottomNavigationItem:
                    name: "engine"
                    text: "Moteur"
                    icon: "engine"
                    FloatLayout:
                        id: engine_root
                        Image:
                            source: app.bg_image
                            fit_mode: "cover"


                        # -------- jauge huile (gauche) --------
                        VBarGauge:
                            id: g_oil_bar
                            vmin: 50
                            vmax: 140
                            warn: 120
                            alarm: 135
                            size_hint_x: 0.045
                            size_hint_y: None
                            height: engine_root.height * 0.62 + dp(100)
                            pos_hint: {"x": 0.03, "center_y": 0.50}
                        MDLabel:
                            text: "130"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"x": 0.09, "top": 0.89}
                        MDLabel:
                            text: "90"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"x": 0.09, "center_y": 0.50}
                        MDLabel:
                            text: "50"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"x": 0.09, "y": 0.115}
                        MDIcon:
                            icon: "oil"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(28), dp(28)
                            pos_hint: {"x": 0.09, "top": 0.335}

                        # -------- jauge niveau carburant (droite) --------
                        VBarGauge:
                            id: g_fuel_bar
                            vmin: 0
                            vmax: 1
                            invert: True
                            warn: 0.2
                            alarm: 0.1
                            size_hint_x: 0.045
                            size_hint_y: None
                            height: engine_root.height * 0.62 + dp(100)
                            pos_hint: {"right": 0.97, "center_y":  0.50}
                        MDLabel:
                            text: "1"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "right"
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"right": 0.90, "top": 0.89}
                        MDLabel:
                            text: "1/2"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "right"
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"right": 0.90, "center_y": 0.50}
                        MDLabel:
                            text: "0"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "right"
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"right": 0.90, "y": 0.115}
                        MDIcon:
                            icon: "gas-station"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(28), dp(28)
                            pos_hint: {"right": 0.907, "y": 0.302}

                        # -------- centre : vitesse + cap --------
                        MDLabel:
                            id: g_speed
                            text: "0"
                            font_style: "H2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            halign: "center"
                            size_hint: None, None
                            size: dp(200), dp(70)
                            pos_hint: {"center_x": 0.5, "top": 0.90}
                        MDLabel:
                            text: "-- km/h --"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "center"
                            size_hint: None, None
                            size: dp(200), dp(24)
                            pos_hint: {"center_x": 0.5, "top": 0.75}
                        HeadingArrow:
                            size_hint: None, None
                            size: dp(28), dp(28)
                            pos_hint: {"center_x": 0.5, "center_y": 0.60}
                        MDLabel:
                            id: g_heading
                            text: "N"
                            font_style: "H3"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            halign: "center"
                            size_hint: None, None
                            size: dp(120), dp(40)
                            pos_hint: {"center_x": 0.5, "center_y": 0.45}

                        # -------- consommation (droite du centre) --------
                        MDLabel:
                            id: g_fuel_inst
                            markup: True
                            text: "[size=28sp][b]0,0[/b][/size] l/km"
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            halign: "center"
                            size_hint: None, None
                            size: dp(200), dp(34)
                            pos_hint: {"right": 0.85, "top": 0.42}
                        MDLabel:
                            text: "-- inst. --"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "center"
                            size_hint: None, None
                            size: dp(200), dp(20)
                            pos_hint: {"right": 0.85, "top": 0.35}
                        MDLabel:
                            id: g_fuel_avg
                            markup: True
                            text: "[size=32sp][b]0,0[/b][/size] [size=14sp]l/km[/size]"
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            halign: "center"
                            size_hint: None, None
                            size: dp(200), dp(34)
                            pos_hint: {"right": 0.85, "top": 0.27}
                        MDLabel:
                            text: "-- moy. --"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "center"
                            size_hint: None, None
                            size: dp(200), dp(20)
                            pos_hint: {"right": 0.85, "top": 0.20}

                        # -------- ligne du bas : liquide / batterie / autonomie --------
                        MDIcon:
                            icon: "thermometer"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(24), dp(24)
                            pos_hint: {"x": 0.255, "y": 0.08}
                        MDLabel:
                            text: "C"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(20), dp(24)
                            pos_hint: {"x": 0.15, "y": 0.040}
                        HBarGauge:
                            id: g_coolant_bar
                            vmin: 40
                            vmax: 130
                            warn: 105
                            alarm: 115
                            size_hint: 0.18, 0.02
                            pos_hint: {"x": 0.17, "y": 0.05}
                        MDLabel:
                            text: "H"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(20), dp(24)
                            pos_hint: {"x": 0.36, "y": 0.040}

                        MDIcon:
                            icon: "car-battery"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(30), dp(30)
                            pos_hint: {"x": 0.45, "y": 0.045}
                        MDLabel:
                            id: g_battery
                            markup: True
                            text: "[size=22sp]12,7[/size] [size=14sp]v[/size]"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            size_hint: None, None
                            size: dp(90), dp(24)
                            pos_hint: {"x": 0.49, "y": 0.045}

                        MDIcon:
                            icon: "gas-station"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(24), dp(24)
                            pos_hint: {"x": 0.7, "y": 0.045}
                        MDLabel:
                            id: g_range
                            markup: True
                            text: "450 [size=14sp]km[/size]"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            size_hint: None, None
                            size: dp(90), dp(24)
                            pos_hint: {"x": 0.74, "y": 0.045}

                # ---------------- Écran 2 : inclinaison ----------------
                MDBottomNavigationItem:
                    name: "tilt"
                    text: "Inclinaison"
                    icon: "angle-acute"
                    FloatLayout:
                        id: tilt_root

                        Image:
                            source: app.bg_image
                            fit_mode: "cover"

                        # -------- roulis / tangage : cadrans façon clinomètre --------
                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(12)
                            padding: dp(12)
                            size_hint: 0.62, 0.85
                            pos_hint: {"x": 0.0, "center_y": 0.5}
                            MDCard:
                                orientation: "vertical"
                                md_bg_color: 0, 0, 0, 0
                                elevation: 0
                                padding: dp(8)
                                MDLabel:
                                    text: "Roulis (lateral)"
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: app.c_text_dim
                                    size_hint_y: 0.12
                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_y: 0.68
                                    MDLabel:
                                        text: "40\n30\n20\n10\n0\n10\n20\n30\n40"
                                        halign: "center"
                                        valign: "middle"
                                        text_size: self.size
                                        font_size: sp(10)
                                        theme_text_color: "Custom"
                                        text_color: app.c_text_dim
                                        size_hint_x: 0.16
                                    FloatLayout:
                                        size_hint_x: 0.68
                                        TiltIndicator:
                                            id: roll
                                            axis: "roll"
                                            size_hint: 1, 1
                                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                        MDIcon:
                                            icon: "car-back"
                                            font_size: sp(56)
                                            theme_text_color: "Custom"
                                            text_color: app.c_text_dim
                                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                    MDLabel:
                                        text: "40\n30\n20\n10\n0\n10\n20\n30\n40"
                                        halign: "center"
                                        valign: "middle"
                                        text_size: self.size
                                        font_size: sp(10)
                                        theme_text_color: "Custom"
                                        text_color: app.c_text_dim
                                        size_hint_x: 0.16
                                MDLabel:
                                    text: "{:+.0f}°".format(round(roll.angle) + 0.0)
                                    halign: "center"
                                    font_style: "H4"
                                    theme_text_color: "Custom"
                                    text_color: app.c_text
                                    size_hint_y: 0.2
                            MDCard:
                                orientation: "vertical"
                                md_bg_color: 0, 0, 0, 0
                                elevation: 0
                                padding: dp(8)
                                MDLabel:
                                    text: "Tangage (avant/arriere)"
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: app.c_text_dim
                                    size_hint_y: 0.12
                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_y: 0.68
                                    MDLabel:
                                        text: "40\n30\n20\n10\n0\n10\n20\n30\n40"
                                        halign: "center"
                                        valign: "middle"
                                        text_size: self.size
                                        font_size: sp(10)
                                        theme_text_color: "Custom"
                                        text_color: app.c_text_dim
                                        size_hint_x: 0.16
                                    FloatLayout:
                                        size_hint_x: 0.68
                                        TiltIndicator:
                                            id: pitch
                                            axis: "pitch"
                                            size_hint: 1, 1
                                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                        MDIcon:
                                            icon: "car-side"
                                            font_size: sp(56)
                                            theme_text_color: "Custom"
                                            text_color: app.c_text_dim
                                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                    MDLabel:
                                        text: "40\n30\n20\n10\n0\n10\n20\n30\n40"
                                        halign: "center"
                                        valign: "middle"
                                        text_size: self.size
                                        font_size: sp(10)
                                        theme_text_color: "Custom"
                                        text_color: app.c_text_dim
                                        size_hint_x: 0.16
                                MDLabel:
                                    text: "{:+.0f}°".format(round(pitch.angle) + 0.0)
                                    halign: "center"
                                    font_style: "H4"
                                    theme_text_color: "Custom"
                                    text_color: app.c_text
                                    size_hint_y: 0.2

                        # -------- panneau droit : cap + vitesse --------
                        HeadingArrow:
                            size_hint: None, None
                            size: dp(40), dp(40)
                            pos_hint: {"center_x": 0.84, "top": 0.85}
                        MDLabel:
                            id: g_heading2
                            text: "N"
                            font_style: "H3"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            halign: "center"
                            size_hint: None, None
                            size: dp(120), dp(40)
                            pos_hint: {"center_x": 0.84, "center_y": 0.68}
                        MDLabel:
                            id: g_speed2
                            text: "0"
                            font_style: "H2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            halign: "center"
                            size_hint: None, None
                            size: dp(160), dp(60)
                            pos_hint: {"center_x": 0.84, "center_y": 0.40}
                        MDLabel:
                            text: "-- km/h --"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "center"
                            size_hint: None, None
                            size: dp(160), dp(24)
                            pos_hint: {"center_x": 0.84, "y": 0.30}

                        # -------- remise à zéro tangage/roulis (bas gauche) --------
                        MDFloatingActionButton:
                            icon: "restore"
                            md_bg_color: app.c_accent
                            icon_color: 1, 1, 1, 1
                            pos_hint: {"x": 0.02, "y": 0.03}
                            on_release: app.reset_tilt()

                # ---------------- Écran 3 : pneus ----------------
                MDBottomNavigationItem:
                    name: "tires"
                    text: "Pneus"
                    icon: "car-tire-alert"
                    FloatLayout:
                        id: tires_root
                        Image:
                            source: app.bg_image
                            fit_mode: "cover"

                        # -------- silhouette véhicule + 4 pneus (centre) --------
                        TireDiagram:
                            id: tires
                            size_hint: 0.30, 0.82
                            pos_hint: {"center_x": .5, "center_y": .5}

                        # -------- avant-gauche --------
                        TireFanGauge:
                            id: g_tire_fl
                            value: tires.fl
                            size_hint: None, None
                            size: dp(46), dp(58)
                            pos_hint: {"x": 0.03, "top": 0.90}
                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint: None, None
                            size: dp(150), dp(120)
                            pos_hint: {"x": 0.13, "top": 0.94}
                            MDLabel:
                                text: "{:.2f}".format(tires.fl)
                                halign: "center"
                                font_style: "H4"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.c_text
                            MDLabel:
                                text: "— bar —"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: app.c_text
                                size_hint_y: 0.5
                            MDLabel:
                                text: "{:.0f}°".format(tires.fl_t)
                                halign: "center"
                                font_style: "H6"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.c_text

                        # -------- avant-droite --------
                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint: None, None
                            size: dp(150), dp(120)
                            pos_hint: {"right": 0.87, "top": 0.94}
                            MDLabel:
                                text: "{:.2f}".format(tires.fr)
                                halign: "center"
                                font_style: "H4"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.c_text
                            MDLabel:
                                text: "— bar —"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: app.c_text
                                size_hint_y: 0.5
                            MDLabel:
                                text: "{:.0f}°".format(tires.fr_t)
                                halign: "center"
                                font_style: "H6"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.c_text
                        TireFanGauge:
                            id: g_tire_fr
                            value: tires.fr
                            size_hint: None, None
                            size: dp(46), dp(58)
                            pos_hint: {"right": 0.97, "top": 0.90}

                        # -------- arrière-gauche --------
                        TireFanGauge:
                            id: g_tire_rl
                            value: tires.rl
                            size_hint: None, None
                            size: dp(46), dp(58)
                            pos_hint: {"x": 0.03, "y": 0.06}
                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint: None, None
                            size: dp(150), dp(120)
                            pos_hint: {"x": 0.13, "y": 0.02}
                            MDLabel:
                                text: "{:.2f}".format(tires.rl)
                                halign: "center"
                                font_style: "H4"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.c_text
                            MDLabel:
                                text: "— bar —"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: app.c_text
                                size_hint_y: 0.5
                            MDLabel:
                                text: "{:.0f}°".format(tires.rl_t)
                                halign: "center"
                                font_style: "H6"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.c_text

                        # -------- arrière-droite --------
                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint: None, None
                            size: dp(150), dp(120)
                            pos_hint: {"right": 0.87, "y": 0.02}
                            MDLabel:
                                text: "{:.2f}".format(tires.rr)
                                halign: "center"
                                font_style: "H4"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.c_text
                            MDLabel:
                                text: "— bar —"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: app.c_text
                                size_hint_y: 0.5
                            MDLabel:
                                text: "{:.0f}°".format(tires.rr_t)
                                halign: "center"
                                font_style: "H6"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.c_text
                        TireFanGauge:
                            id: g_tire_rr
                            value: tires.rr
                            size_hint: None, None
                            size: dp(46), dp(58)
                            pos_hint: {"right": 0.97, "y": 0.06}

        # Température extérieure : superposée en haut à gauche de la top bar
        # (celle-ci ne peut pas afficher de texte libre dans ses action items,
        # qui n'acceptent que des icônes).
        MDLabel:
            id: g_ext
            text: "--°"
            font_style: "H6"
            bold: True
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            size_hint: None, None
            size: dp(70), dp(30)
            pos_hint: {"x": 0.01}
            y: topbar.center_y - self.height / 2
