#:import NoTransition kivy.uix.screenmanager.NoTransition
#:import telemetry telemetry

# Interface Material Design (KivyMD 1.1.1).
# Les jauges/inclinomètre/pneus restent des widgets canvas (légers).
# Les couleurs canvas pointent vers app.c_* (dérivées de theme_cls).

# --------------------------------------------------------------------------- #
#  Écran de démarrage (logo sur fond noir, affiché quelques secondes)
# --------------------------------------------------------------------------- #
<SplashScreen>:
    md_bg_color: 0, 0, 0, 1

    Image:
        source: "assets/logo_toyota.png"
        size_hint: None, None
        width: dp(320)
        height: self.image_ratio and dp(320) / self.image_ratio
        pos_hint: {"center_x": 0.5, "center_y": 0.5}

# --------------------------------------------------------------------------- #
#  Racine
# --------------------------------------------------------------------------- #
<RootScreen>:
    FloatLayout:
        Image:
            source: app.bg_image
            fit_mode: "cover"

        MDBoxLayout:
            orientation: "vertical"

            MDTopAppBar:
                id: topbar
                title: app.clock_str
                anchor_title: "center"
                elevation: 0
                md_bg_color: 0, 0, 0, 0.01
                specific_text_color: 1, 1, 1, 1
                right_action_items: [["weather-night" if not app.night_mode else "white-balance-sunny", lambda x: app.toggle_night()], ["cog", lambda x: app.open_settings()], ["power", lambda x: app.ask_shutdown()]]

            MDBottomNavigation:
                id: nav
                #panel_color: app.theme_cls.primary_color
                # NoTransition avoids MDBottomNavigation's default FadeTransition
                # (FBO/shader-based screen compositing). That transition leaves stale
                # GPU framebuffer content visible through transparent gaps in sparse
                # tab layouts (e.g. the tilt tab) after switching tabs — confirmed via
                # screenshots at 0.8s/3s/7.5s post-switch and across every tab pairing.
                transition: NoTransition
                # NoTransition doesn't reposition screens during the switch (its
                # on_progress is a no-op) — it just keeps both screens added to the
                # manager, fully overlapped, until on_complete removes the old one
                # after `transition_duration`. Force that window to 0 so the old
                # screen is dropped on the very next frame instead of sitting
                # stacked under the new one for 0.2s (the default).
                transition_duration: 0

                # ---------------- Écran 1 : moteur ----------------
                MDBottomNavigationItem:
                    name: "engine"
                    text: "Moteur"
                    icon: "engine"
                    md_bg_color: 0, 0, 0, 0
                    FloatLayout:
                        id: engine_root

                        # -------- jauge huile (gauche) --------
                        VBarGauge:
                            id: g_oil_bar
                            vmin: 50
                            vmax: 140
                            warn: 120
                            alarm: 135
                            size_hint_x: 0.045
                            size_hint_y: None
                            height: engine_root.height * 0.62 + dp(100)
                            pos_hint: {"x": 0.03, "center_y": 0.50}
                        MDLabel:
                            text: "130"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"x": 0.09, "top": 0.89}
                        MDLabel:
                            text: "90"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"x": 0.09, "center_y": 0.50}
                        MDLabel:
                            text: "50"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"x": 0.09, "y": 0.115}
                        MDIcon:
                            icon: "oil"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(28), dp(28)
                            pos_hint: {"x": 0.09, "top": 0.335}

                        # -------- jauge niveau carburant (droite) --------
                        VBarGauge:
                            id: g_fuel_bar
                            vmin: 0
                            vmax: 1
                            invert: True
                            warn: 0.2
                            alarm: 0.1
                            size_hint_x: 0.045
                            size_hint_y: None
                            height: engine_root.height * 0.62 + dp(100)
                            pos_hint: {"right": 0.97, "center_y":  0.50}
                        MDLabel:
                            text: "1"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "right"
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"right": 0.90, "top": 0.89}
                        MDLabel:
                            text: "1/2"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "right"
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"right": 0.90, "center_y": 0.50}
                        MDLabel:
                            text: "0"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "right"
                            size_hint: None, None
                            size: dp(60), dp(24)
                            pos_hint: {"right": 0.90, "y": 0.115}
                        MDIcon:
                            icon: "gas-station"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(28), dp(28)
                            pos_hint: {"right": 0.907, "y": 0.302}

                        # -------- centre : vitesse + cap --------
                        MDLabel:
                            id: g_speed
                            text: "0"
                            font_style: "H2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            halign: "center"
                            size_hint: None, None
                            size: dp(200), dp(70)
                            pos_hint: {"center_x": 0.5, "top": 0.90}
                        MDIcon:
                            icon: "alert"
                            theme_text_color: "Custom"
                            text_color: app.c_warn
                            opacity: 1 if app.tire_mismatch else 0
                            size_hint: None, None
                            size: dp(20), dp(20)
                            pos_hint: {"x": 0.54, "y": 0.79}
                        MDLabel:
                            text: "-- km/h --"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "center"
                            size_hint: None, None
                            size: dp(200), dp(24)
                            pos_hint: {"center_x": 0.5, "top": 0.75}
                        HeadingArrow:
                            size_hint: None, None
                            size: dp(28), dp(28)
                            pos_hint: {"center_x": 0.5, "center_y": 0.60}
                        MDLabel:
                            id: g_heading
                            text: "N"
                            font_style: "H3"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            halign: "center"
                            size_hint: None, None
                            size: dp(120), dp(40)
                            pos_hint: {"center_x": 0.5, "center_y": 0.45}

                        # -------- consommation (droite du centre) --------
                        MDLabel:
                            id: g_fuel_inst
                            markup: True
                            text: "[size=28sp][b]0,0[/b][/size] l/km"
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            halign: "center"
                            size_hint: None, None
                            size: dp(200), dp(34)
                            pos_hint: {"right": 0.85, "top": 0.42}
                        MDLabel:
                            text: "-- inst. --"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "center"
                            size_hint: None, None
                            size: dp(200), dp(20)
                            pos_hint: {"right": 0.85, "top": 0.35}
                        MDIcon:
                            icon: "alert"
                            theme_text_color: "Custom"
                            text_color: app.c_warn
                            opacity: 1 if app.tire_mismatch else 0
                            size_hint: None, None
                            size: dp(20), dp(20)
                            pos_hint: {"x": 0.80, "y": 0.365}
                        MDLabel:
                            id: g_fuel_avg
                            markup: True
                            text: "[size=32sp][b]0,0[/b][/size] [size=14sp]l/km[/size]"
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            halign: "center"
                            size_hint: None, None
                            size: dp(200), dp(34)
                            pos_hint: {"right": 0.85, "top": 0.27}
                        MDLabel:
                            text: "-- moy. --"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "center"
                            size_hint: None, None
                            size: dp(200), dp(20)
                            pos_hint: {"right": 0.85, "top": 0.20}
                        MDIcon:
                            icon: "alert"
                            theme_text_color: "Custom"
                            text_color: app.c_warn
                            opacity: 1 if app.tire_mismatch else 0
                            size_hint: None, None
                            size: dp(20), dp(20)
                            pos_hint: {"x": 0.80, "y": 0.215}

                        # -------- ligne du bas : liquide / batterie / autonomie --------
                        MDIcon:
                            icon: "thermometer"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(24), dp(24)
                            pos_hint: {"x": 0.255, "y": 0.08}
                        MDLabel:
                            text: "C"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(20), dp(24)
                            pos_hint: {"x": 0.15, "y": 0.040}
                        HBarGauge:
                            id: g_coolant_bar
                            vmin: 40
                            vmax: 130
                            warn: 105
                            alarm: 115
                            size_hint: 0.18, 0.02
                            pos_hint: {"x": 0.17, "y": 0.05}
                        MDLabel:
                            text: "H"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(20), dp(24)
                            pos_hint: {"x": 0.36, "y": 0.040}

                        MDIcon:
                            icon: "car-battery"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(30), dp(30)
                            pos_hint: {"x": 0.45, "y": 0.045}
                        MDLabel:
                            id: g_battery
                            markup: True
                            text: "[size=22sp]12,7[/size] [size=14sp]v[/size]"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            size_hint: None, None
                            size: dp(90), dp(24)
                            pos_hint: {"x": 0.49, "y": 0.045}

                        MDIcon:
                            icon: "gas-station"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            size_hint: None, None
                            size: dp(24), dp(24)
                            pos_hint: {"x": 0.7, "y": 0.045}
                        MDLabel:
                            id: g_range
                            markup: True
                            text: "450 [size=14sp]km[/size]"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            size_hint: None, None
                            size: dp(90), dp(24)
                            pos_hint: {"x": 0.74, "y": 0.045}
                        MDIcon:
                            icon: "alert"
                            theme_text_color: "Custom"
                            text_color: app.c_warn
                            opacity: 1 if app.tire_mismatch else 0
                            size_hint: None, None
                            size: dp(20), dp(20)
                            pos_hint: {"x": 0.82, "y": 0.045}

                # ---------------- Écran 2 : inclinaison ----------------
                MDBottomNavigationItem:
                    name: "tilt"
                    text: "Inclinaison"
                    icon: "angle-acute"
                    md_bg_color: 0, 0, 0, 0
                    FloatLayout:
                        id: tilt_root

                        # -------- roulis / tangage : cadrans façon clinomètre --------
                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(12)
                            padding: dp(12)
                            size_hint: 0.62, 0.85
                            pos_hint: {"x": 0.0, "center_y": 0.5}
                            MDCard:
                                orientation: "vertical"
                                md_bg_color: 0, 0, 0, 0
                                elevation: 0
                                padding: dp(8)
                                MDLabel:
                                    text: "Roulis (lateral)"
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: app.c_text_dim
                                    size_hint_y: 0.12
                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_y: 0.68
                                    MDLabel:
                                        text: "40\n30\n20\n10\n0\n10\n20\n30\n40"
                                        halign: "center"
                                        valign: "middle"
                                        text_size: self.size
                                        font_size: sp(10)
                                        theme_text_color: "Custom"
                                        text_color: app.c_text_dim
                                        size_hint_x: 0.16
                                    FloatLayout:
                                        size_hint_x: 0.68
                                        TiltIndicator:
                                            id: roll
                                            axis: "roll"
                                            size_hint: 1, 1
                                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                        MDIcon:
                                            icon: "car-back"
                                            font_size: sp(56)
                                            theme_text_color: "Custom"
                                            text_color: app.c_text_dim
                                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                    MDLabel:
                                        text: "40\n30\n20\n10\n0\n10\n20\n30\n40"
                                        halign: "center"
                                        valign: "middle"
                                        text_size: self.size
                                        font_size: sp(10)
                                        theme_text_color: "Custom"
                                        text_color: app.c_text_dim
                                        size_hint_x: 0.16
                                MDLabel:
                                    text: "{:+.0f}°".format(round(roll.angle) + 0.0)
                                    halign: "center"
                                    font_style: "H4"
                                    theme_text_color: "Custom"
                                    text_color: app.c_text
                                    size_hint_y: 0.2
                            MDCard:
                                orientation: "vertical"
                                md_bg_color: 0, 0, 0, 0
                                elevation: 0
                                padding: dp(8)
                                MDLabel:
                                    text: "Tangage (avant/arriere)"
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: app.c_text_dim
                                    size_hint_y: 0.12
                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_y: 0.68
                                    MDLabel:
                                        text: "40\n30\n20\n10\n0\n10\n20\n30\n40"
                                        halign: "center"
                                        valign: "middle"
                                        text_size: self.size
                                        font_size: sp(10)
                                        theme_text_color: "Custom"
                                        text_color: app.c_text_dim
                                        size_hint_x: 0.16
                                    FloatLayout:
                                        size_hint_x: 0.68
                                        TiltIndicator:
                                            id: pitch
                                            axis: "pitch"
                                            size_hint: 1, 1
                                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                        MDIcon:
                                            icon: "car-side"
                                            font_size: sp(56)
                                            theme_text_color: "Custom"
                                            text_color: app.c_text_dim
                                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                    MDLabel:
                                        text: "40\n30\n20\n10\n0\n10\n20\n30\n40"
                                        halign: "center"
                                        valign: "middle"
                                        text_size: self.size
                                        font_size: sp(10)
                                        theme_text_color: "Custom"
                                        text_color: app.c_text_dim
                                        size_hint_x: 0.16
                                MDLabel:
                                    text: "{:+.0f}°".format(round(pitch.angle) + 0.0)
                                    halign: "center"
                                    font_style: "H4"
                                    theme_text_color: "Custom"
                                    text_color: app.c_text
                                    size_hint_y: 0.2

                        # -------- panneau droit : cap + vitesse --------
                        HeadingArrow:
                            size_hint: None, None
                            size: dp(40), dp(40)
                            pos_hint: {"center_x": 0.84, "top": 0.85}
                        MDLabel:
                            id: g_heading2
                            text: "N"
                            font_style: "H3"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            halign: "center"
                            size_hint: None, None
                            size: dp(120), dp(40)
                            pos_hint: {"center_x": 0.84, "center_y": 0.68}
                        MDLabel:
                            id: g_speed2
                            text: "0"
                            font_style: "H2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.c_text
                            halign: "center"
                            size_hint: None, None
                            size: dp(160), dp(60)
                            pos_hint: {"center_x": 0.84, "center_y": 0.40}
                        MDIcon:
                            icon: "alert"
                            theme_text_color: "Custom"
                            text_color: app.c_warn
                            opacity: 1 if app.tire_mismatch else 0
                            size_hint: None, None
                            size: dp(20), dp(20)
                            pos_hint: {"x": 0.88, "y": 0.36}
                        MDLabel:
                            text: "-- km/h --"
                            theme_text_color: "Custom"
                            text_color: app.c_text_dim
                            halign: "center"
                            size_hint: None, None
                            size: dp(160), dp(24)
                            pos_hint: {"center_x": 0.84, "y": 0.30}

                        # -------- remise à zéro tangage/roulis (bas gauche) --------
                        MDFloatingActionButton:
                            icon: "restore"
                            md_bg_color: app.c_accent
                            icon_color: 1, 1, 1, 1
                            pos_hint: {"x": 0.02, "y": 0.03}
                            on_release: app.reset_tilt()

                # ---------------- Écran 3 : pneus ----------------
                MDBottomNavigationItem:
                    name: "tires"
                    text: "Pneus"
                    icon: "car-tire-alert"
                    md_bg_color: 0, 0, 0, 0
                    FloatLayout:
                        id: tires_root

                        # -------- silhouette véhicule + 4 pneus (centre) --------
                        TireDiagram:
                            id: tires
                            target: app.c_tire_target
                            tol: app.c_tire_tol
                            size_hint: 0.30, 0.82
                            pos_hint: {"center_x": .5, "center_y": .5}

                        # -------- avant-gauche --------
                        TireFanGauge:
                            id: g_tire_fl
                            value: tires.fl
                            target: app.c_tire_target
                            tol: app.c_tire_tol
                            size_hint: None, None
                            size: dp(46), dp(58)
                            pos_hint: {"x": 0.08, "top": 0.90}
                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint: None, None
                            size: dp(150), dp(120)
                            pos_hint: {"x": 0.13, "top": 0.94}
                            MDLabel:
                                text: "{:.2f}".format(tires.fl)
                                halign: "center"
                                font_style: "H4"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.c_text
                            MDLabel:
                                text: "— bar —"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: app.c_text
                                size_hint_y: 0.5
                            MDLabel:
                                text: "{:.0f}°".format(tires.fl_t)
                                halign: "center"
                                font_style: "H6"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.c_text

                        # -------- avant-droite --------
                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint: None, None
                            size: dp(150), dp(120)
                            pos_hint: {"right": 0.82, "top": 0.94}
                            MDLabel:
                                text: "{:.2f}".format(tires.fr)
                                halign: "center"
                                font_style: "H4"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.c_text
                            MDLabel:
                                text: "— bar —"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: app.c_text
                                size_hint_y: 0.5
                            MDLabel:
                                text: "{:.0f}°".format(tires.fr_t)
                                halign: "center"
                                font_style: "H6"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.c_text
                        TireFanGauge:
                            id: g_tire_fr
                            value: tires.fr
                            target: app.c_tire_target
                            tol: app.c_tire_tol
                            size_hint: None, None
                            size: dp(46), dp(58)
                            pos_hint: {"right": 0.88, "top": 0.90}

                        # -------- arrière-gauche --------
                        TireFanGauge:
                            id: g_tire_rl
                            value: tires.rl
                            target: app.c_tire_target
                            tol: app.c_tire_tol
                            size_hint: None, None
                            size: dp(46), dp(58)
                            pos_hint: {"x": 0.08, "y": 0.09}
                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint: None, None
                            size: dp(150), dp(120)
                            pos_hint: {"x": 0.13, "y": 0.02}
                            MDLabel:
                                text: "{:.2f}".format(tires.rl)
                                halign: "center"
                                font_style: "H4"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.c_text
                            MDLabel:
                                text: "— bar —"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: app.c_text
                                size_hint_y: 0.5
                            MDLabel:
                                text: "{:.0f}°".format(tires.rl_t)
                                halign: "center"
                                font_style: "H6"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.c_text

                        # -------- arrière-droite --------
                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint: None, None
                            size: dp(150), dp(120)
                            pos_hint: {"right": 0.82, "y": 0.02}
                            MDLabel:
                                text: "{:.2f}".format(tires.rr)
                                halign: "center"
                                font_style: "H4"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.c_text
                            MDLabel:
                                text: "— bar —"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: app.c_text
                                size_hint_y: 0.5
                            MDLabel:
                                text: "{:.0f}°".format(tires.rr_t)
                                halign: "center"
                                font_style: "H6"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.c_text
                        TireFanGauge:
                            id: g_tire_rr
                            value: tires.rr
                            target: app.c_tire_target
                            tol: app.c_tire_tol
                            size_hint: None, None
                            size: dp(46), dp(58)
                            pos_hint: {"right": 0.88, "y": 0.09}

        # Bouton extinction d'écran : superposé en haut à gauche de la top
        # bar, avant la température (même contrainte que celle-ci : la top
        # bar n'a que right_action_items d'utilisés ici).
        MDIconButton:
            icon: "monitor-off"
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            pos_hint: {"x": 0.005}
            y: topbar.center_y - self.height / 2
            on_release: app.screen_off()

        # Température extérieure : superposée en haut à gauche de la top bar
        # (celle-ci ne peut pas afficher de texte libre dans ses action items,
        # qui n'acceptent que des icônes).
        MDLabel:
            id: g_ext
            text: "--°"
            font_style: "H6"
            bold: True
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            size_hint: None, None
            size: dp(70), dp(30)
            pos_hint: {"x": 0.075}
            y: topbar.center_y - self.height / 2

# --------------------------------------------------------------------------- #
#  Écran réglages : onglets, chacun lié à un écran indépendant
# --------------------------------------------------------------------------- #
<SettingsScreen>:
    FloatLayout:
        Image:
            source: app.bg_image
            fit_mode: "cover"

        MDBoxLayout:
            orientation: "vertical"

            MDTopAppBar:
                title: "Réglages"
                elevation: 0
                md_bg_color: 0, 0, 0, 0.01
                specific_text_color: 1, 1, 1, 1
                left_action_items: [["arrow-left", lambda x: app.close_settings()]]

            MDTabs:
                id: settings_tabs
                background_color: 0, 0, 0, 0.5
                text_color_normal: app.c_text
                text_color_active: app.c_accent
                indicator_color: app.c_accent

                CalibrationTab:
                    title: "Calibration"
                    icon: "axis-arrow"

                TiresSettingsTab:
                    title: "Pneus"
                    icon: "car-tire-alert"

                TireSizeTab:
                    title: "Taille pneus"
                    icon: "tape-measure"

                UnitsTab:
                    title: "Unités"
                    icon: "ruler"

                NetworkTab:
                    title: "Réseau"
                    icon: "wifi"

                TerminalTab:
                    title: "Terminal"
                    icon: "console-line"

<CalibrationTab>:
    orientation: "vertical"
    padding: dp(28)
    spacing: dp(18)
    md_bg_color: 0, 0, 0, 0.5

    MDLabel:
        text: "Décalage appliqué au roulis et au tangage pour compenser le montage du boîtier IMU dans le véhicule (identique au bouton de remise à zéro de l'onglet Inclinaison)."
        theme_text_color: "Custom"
        text_color: app.c_text_dim
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1]

    MDLabel:
        text: "Roulis : {:+.1f}°   Tangage : {:+.1f}°".format(app.roll_offset, app.pitch_offset)
        theme_text_color: "Custom"
        text_color: app.c_text
        font_style: "H5"
        bold: True
        size_hint_y: None
        height: self.texture_size[1]

    MDRaisedButton:
        text: "RÉINITIALISER LE ZÉRO"
        md_bg_color: app.c_accent
        size_hint: None, None
        size: dp(260), dp(48)
        on_release: app.reset_tilt()

    Widget:

<TiresSettingsTab>:
    orientation: "vertical"
    padding: dp(28)
    spacing: dp(10)
    md_bg_color: 0, 0, 0, 0.5

    MDLabel:
        text: "Pression cible : {:.2f} bar".format(app.c_tire_target)
        theme_text_color: "Custom"
        text_color: app.c_text
        size_hint_y: None
        height: self.texture_size[1]

    MDSlider:
        min: 1.5
        max: 4.0
        step: 0.05
        value: app.c_tire_target
        on_value: app.c_tire_target = self.value

    MDLabel:
        text: "Tolérance avant alerte : {:.2f} bar".format(app.c_tire_tol)
        theme_text_color: "Custom"
        text_color: app.c_text
        size_hint_y: None
        height: self.texture_size[1]

    MDSlider:
        min: 0.05
        max: 1.0
        step: 0.05
        value: app.c_tire_tol
        on_value: app.c_tire_tol = self.value

    Widget:

<TireSizeTab>:
    orientation: "vertical"
    padding: dp(28)
    spacing: dp(10)
    md_bg_color: 0, 0, 0, 0.5

    MDLabel:
        text: "Pneu d'origine (calibration vitesse/compteur du véhicule) : 255/70 R15"
        theme_text_color: "Custom"
        text_color: app.c_text_dim
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1]

    MDLabel:
        text: "Pneu monté : {:.0f}/{:.0f} R{:.0f}   —   facteur de correction ×{:.3f}".format(app.tire_width, app.tire_aspect, app.tire_rim, app.speed_ratio)
        theme_text_color: "Custom"
        text_color: app.c_text
        font_style: "H6"
        bold: True
        size_hint_y: None
        height: self.texture_size[1]

    MDLabel:
        text: "Largeur : {:.0f} mm".format(app.tire_width)
        theme_text_color: "Custom"
        text_color: app.c_text
        size_hint_y: None
        height: self.texture_size[1]

    MDSlider:
        min: 175
        max: 315
        step: 5
        value: app.tire_width
        on_value: app.tire_width = self.value

    MDLabel:
        text: "Hauteur de flanc : {:.0f} %".format(app.tire_aspect)
        theme_text_color: "Custom"
        text_color: app.c_text
        size_hint_y: None
        height: self.texture_size[1]

    MDSlider:
        min: 30
        max: 85
        step: 5
        value: app.tire_aspect
        on_value: app.tire_aspect = self.value

    MDLabel:
        text: "Diamètre de jante : {:.0f} pouces".format(app.tire_rim)
        theme_text_color: "Custom"
        text_color: app.c_text
        size_hint_y: None
        height: self.texture_size[1]

    MDSlider:
        min: 13
        max: 20
        step: 1
        value: app.tire_rim
        on_value: app.tire_rim = self.value

    MDRaisedButton:
        text: "RÉINITIALISER LA TAILLE (255/70 R15)"
        md_bg_color: app.c_accent
        size_hint: None, None
        size: dp(320), dp(48)
        on_release: app.reset_tire_size()

    MDLabel:
        text: "Trip (distance corrigée) : {:.1f} km".format(app.trip_km)
        theme_text_color: "Custom"
        text_color: app.c_text
        size_hint_y: None
        height: self.texture_size[1]

    MDRaisedButton:
        text: "RÉINITIALISER LE TRIP"
        md_bg_color: app.c_accent
        size_hint: None, None
        size: dp(220), dp(48)
        on_release: app.reset_trip()

    Widget:

<UnitsTab>:
    orientation: "vertical"
    padding: dp(28)
    md_bg_color: 0, 0, 0, 0.5

    MDLabel:
        text: "Choix des unités (km/h ↔ mph, bar ↔ psi, °C ↔ °F...) — à venir."
        theme_text_color: "Custom"
        text_color: app.c_text_dim
        halign: "center"
        valign: "middle"
        text_size: self.width, self.height

<NetworkTab>:
    orientation: "vertical"
    padding: dp(28)
    spacing: dp(12)
    md_bg_color: 0, 0, 0, 0.5

    MDLabel:
        text: "Broker MQTT : {}:{}".format(telemetry.BROKER_HOST, telemetry.BROKER_PORT)
        theme_text_color: "Custom"
        text_color: app.c_text
        size_hint_y: None
        height: self.texture_size[1]

    MDLabel:
        text: "Source de données : " + ("MQTT" if app.using_mqtt else "simulation locale (HILUX_SOURCE non défini)")
        theme_text_color: "Custom"
        text_color: app.c_text_dim
        size_hint_y: None
        height: self.texture_size[1]

    Widget:

<TerminalTab>:
    padding: dp(8)
    md_bg_color: 0, 0, 0, 0.5

    TerminalConsole:

# --------------------------------------------------------------------------- #
#  Terminal shell interactif (bash dans un pty, cf. terminal.py)
# --------------------------------------------------------------------------- #
<TerminalConsole>:
    orientation: "vertical"
    spacing: dp(6)
    padding: dp(6)
    md_bg_color: 0, 0, 0, 0.6

    ScrollView:
        id: scroll
        bar_width: dp(4)
        do_scroll_x: False

        MDLabel:
            text: root.output_text
            theme_text_color: "Custom"
            text_color: 0.2, 1, 0.3, 1
            font_style: "Caption"
            size_hint_y: None
            height: max(self.texture_size[1], scroll.height)
            text_size: self.width, None
            padding: dp(6), dp(6)
            halign: "left"
            valign: "top"

    MDBoxLayout:
        size_hint_y: None
        height: dp(48)
        spacing: dp(6)

        MDTextField:
            id: input_field
            hint_text: "commande shell…"
            mode: "rectangle"
            multiline: False
            on_text_validate: root.send_line(self.text); self.text = ""

        MDIconButton:
            icon: "stop"
            theme_text_color: "Custom"
            text_color: app.c_warn
            on_release: root.send_interrupt()

        MDIconButton:
            icon: "delete-sweep"
            theme_text_color: "Custom"
            text_color: app.c_text_dim
            on_release: root.clear_output()
